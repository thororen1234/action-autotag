{
  "name": "autotag-action",
  "version": "1.1.5",
  "private": true,
  "description": "Automatically create a tag whenever the version changes in package.json",
  "main": "app/main.js",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "pnpm exec esbuild --bundle ./src/main.js --format=esm --platform=node --outdir=dist --external:octokit --external:@actions/core --external:semver"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thororen1234/action-autotag.git"
  },
  "author": "Corey Butler",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thororen1234/action-autotag/issues"
  },
  "homepage": "https://github.com/thororen1234/action-autotag#readme",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  }
}